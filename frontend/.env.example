# Backend URL as seen from the phone. Use your laptop LAN IP on a real device.
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Optional: real Google Calendar sync. Create OAuth client IDs in Google Cloud
# Console (APIs & Services > Credentials) with the Google Calendar API enabled.
# Without these the app can only load labelled demo events.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=            # "Web application" client
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=    # "Android" client (needs a development build, not Expo Go)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=        # "iOS" client
