{
  "expo": {
    "name": "Tandem",
    "slug": "tandem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#234F91"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F1F5FC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0D1626"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tandem shows where you are on the map of your trip."
        }
      ]
    ]
  }
}
